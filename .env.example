APP_ENV=development
APP_SEED_DEFAULTS=true
EVENT_TIMEZONE=Europe/Madrid

POSTGRES_DB=bss_timecollection
POSTGRES_USER=bss_timecollection
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://bss_timecollection:change-me@db:5432/bss_timecollection
DATABASE_ADMIN_TEST_ENABLED=false

ORACLE_ENABLED=false
ORACLE_BASE_URL=https://example.oraclecloud.com
ORACLE_API_PATH=/hcmRestApi/resources/11.13.18.05/timeEventRequests
ORACLE_SOURCE_ID=HWM_CLOCK_TIME
ORACLE_REPORTER_ID_TYPE=BADGE
ORACLE_AUTH_MODE=none
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_BEARER_TOKEN=
ORACLE_TIMEOUT_SECONDS=15

TERMINAL_COOKIE_SECURE=false
TERMINAL_SESSION_DAYS=365
TERMINAL_PAIRING_MINUTES=10

# Temporary Admin auth credentials are supplied through environment only.
ADMIN_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=8
ADMIN_COOKIE_SECURE=false
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=300

WORKER_POLL_SECONDS=3
WORKER_STALE_SENDING_SECONDS=300
