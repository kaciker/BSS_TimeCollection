APP_ENV=development
APP_SEED_DEFAULTS=true
EVENT_TIMEZONE=Europe/Madrid

POSTGRES_DB=bss_timecollection
POSTGRES_USER=bss_timecollection
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://bss_timecollection:change-me@db:5432/bss_timecollection

ORACLE_ENABLED=false
ORACLE_BASE_URL=https://example.oraclecloud.com
ORACLE_API_PATH=/hcmRestApi/resources/11.13.18.05/timeEventRequests
ORACLE_SOURCE_ID=HWM_CLOCK_TIME
ORACLE_AUTH_MODE=none
