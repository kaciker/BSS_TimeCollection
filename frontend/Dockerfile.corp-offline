# Offline build: dependencies are the existing validated node_modules.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.json vite.config.ts index.html ./
COPY node_modules.tar.gz /tmp/node_modules.tar.gz
RUN tar -xzf /tmp/node_modules.tar.gz && rm /tmp/node_modules.tar.gz && rm -rf /app/node_modules/node_modules && \
    test "$(find /app/node_modules -path "*/node_modules/react/package.json" -type f | wc -l)" -eq 1 && \
    test "$(find /app/node_modules -path "*/node_modules/react-dom/package.json" -type f | wc -l)" -eq 1
COPY src ./src
COPY tests ./tests
COPY img ./public/img
COPY public/action-visuals ./public/action-visuals
RUN npm test && npm run build
FROM bsstimecollection-web:admin-columns-20261029
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/dist /usr/share/nginx/html
LABEL org.opencontainers.image.revision="oracle-hrpath-contract-20261029"
