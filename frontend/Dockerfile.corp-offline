# Offline build: dependencies are the existing validated node_modules.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json tsconfig.json vite.config.ts index.html ./
COPY node_modules.tar.gz /tmp/node_modules.tar.gz
RUN tar -xzf /tmp/node_modules.tar.gz && rm /tmp/node_modules.tar.gz
COPY src ./src
COPY tests ./tests
COPY img ./public/img
COPY public/action-visuals ./public/action-visuals
RUN npm test && npm run build
FROM bsstimecollection-web:pre-perimeter-20261020
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/dist /usr/share/nginx/html
LABEL org.opencontainers.image.revision="a414089787f68f0d72394557efebd33195fa20cb+corp-corrections"
